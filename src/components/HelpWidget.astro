---
// Docs copilot overlay (see docs/howto-chat-plan.md, Phase 1).
//
// Rendered only on DMX Core 100 pages — the copilot's corpus — and only when the
// build sets PUBLIC_HELP_API_URL, so the docs can deploy before the API is live.
// PUBLIC_HELP_CONTINUE_URL is the portal handoff (…/help?continue={sessionId});
// an empty value hides the "Continue with my device" link.
const apiUrl = import.meta.env.PUBLIC_HELP_API_URL;
const continueUrl = import.meta.env.PUBLIC_HELP_CONTINUE_URL ?? 'https://portal.dmxcore.com/help';
const enabled = Boolean(apiUrl) && Astro.url.pathname.startsWith('/dmx-core-100');
---

{
  enabled && (
    <div class="dmx-help not-content" data-dmx-help data-api={apiUrl} data-continue={continueUrl} />
  )
}

<script>
  import '../help-widget/widget.js';
</script>

<style is:global>
  .dmx-help [hidden] {
    display: none !important;
  }

  .dmx-help {
    font-family: var(--sl-font, system-ui, sans-serif);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .dmx-help button {
    font: inherit;
    cursor: pointer;
  }

  .dmx-help-launcher {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem 0.55rem 0.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font-weight: 600;
    box-shadow: var(--sl-shadow-md);
  }

  .dmx-help-launcher-icon {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--sl-color-black);
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }

  .dmx-help-panel {
    position: fixed;
    right: 1.25rem;
    bottom: 4.75rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    width: min(27rem, calc(100vw - 2.5rem));
    height: min(42rem, calc(100vh - 6.5rem));
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: var(--sl-shadow-lg);
    overflow: hidden;
  }

  .dmx-help-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-nav);
  }

  .dmx-help-title {
    margin: 0;
    font-size: var(--sl-text-base);
    color: var(--sl-color-white);
  }

  .dmx-help-subtitle {
    margin: 0.1rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .dmx-help-header-actions {
    display: flex;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .dmx-help-icon-button,
  .dmx-help-step-actions button {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
  }

  .dmx-help-icon-button:hover,
  .dmx-help-step-actions button:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  .dmx-help-messages {
    flex: 1;
    min-height: 7rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.9rem;
    overflow-y: auto;
  }

  .dmx-help-empty p {
    margin: 0 0 0.6rem;
  }

  .dmx-help-hint {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .dmx-help-suggestions {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .dmx-help-suggestion {
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    text-align: left;
  }

  .dmx-help-suggestion:hover {
    border-color: var(--sl-color-text-accent);
  }

  .dmx-help-bubble {
    max-width: 100%;
    padding: 0.5rem 0.7rem;
    border-radius: 0.6rem;
    overflow-wrap: anywhere;
  }

  .dmx-help-user {
    align-self: flex-end;
    max-width: 85%;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    white-space: pre-wrap;
  }

  .dmx-help-assistant {
    background: var(--sl-color-gray-6);
  }

  .dmx-help-markdown p,
  .dmx-help-markdown ul,
  .dmx-help-markdown ol,
  .dmx-help-markdown pre {
    margin: 0.35rem 0;
  }

  .dmx-help-markdown ul,
  .dmx-help-markdown ol {
    padding-inline-start: 1.2rem;
  }

  .dmx-help-markdown code {
    padding: 0 0.25rem;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-5);
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.9em;
  }

  .dmx-help-markdown pre {
    padding: 0.5rem;
    overflow-x: auto;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-5);
  }

  .dmx-help-markdown pre code {
    padding: 0;
    background: none;
  }

  .dmx-help a {
    color: var(--sl-color-text-accent);
  }

  .dmx-help-status,
  .dmx-help-sources {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .dmx-help-error,
  .dmx-help-notice {
    margin: 0.25rem 0 0;
    color: var(--sl-color-red-high, #f87171);
  }

  .dmx-help-notice {
    padding: 0 0.9rem 0.4rem;
    font-size: var(--sl-text-xs);
  }

  .dmx-help-feedback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    font-size: var(--sl-text-xs);
  }

  .dmx-help-feedback button {
    padding: 0 0.35rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    background: transparent;
    line-height: 1.6;
  }

  .dmx-help-feedback button[aria-pressed='true'] {
    border-color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
  }

  .dmx-help-feedback-form {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .dmx-help-feedback-form textarea {
    flex: 1;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    resize: vertical;
  }

  .dmx-help-feedback-form button {
    align-self: flex-end;
    padding: 0.2rem 0.6rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
  }

  .dmx-help-card {
    margin-top: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    scroll-margin-top: 0.5rem;
  }

  .dmx-help-checklist-header {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem 0.3rem;
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .dmx-help-checklist-count {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }

  .dmx-help-steps {
    margin: 0;
    padding: 0 0.7rem 0.4rem;
    list-style: none;
  }

  .dmx-help-checklist-note {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .dmx-help-progress {
    display: block;
    width: 100%;
    padding: 0.4rem 0.9rem;
    overflow: hidden;
    border: 0;
    border-top: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    text-align: left;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .dmx-help-progress:hover {
    color: var(--sl-color-white);
  }

  .dmx-help-step {
    display: flex;
    gap: 0.55rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--sl-color-hairline-light, var(--sl-color-hairline));
  }

  .dmx-help-step input {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.2rem;
    accent-color: var(--sl-color-text-accent);
  }

  .dmx-help-step-body {
    flex: 1;
    min-width: 0;
  }

  .dmx-help-step-body label {
    cursor: pointer;
  }

  .dmx-help-step-done label {
    color: var(--sl-color-gray-3);
    text-decoration: line-through;
  }

  .dmx-help-step-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
  }

  .dmx-help-shot {
    margin: 0.4rem 0 0;
  }

  .dmx-help-shot-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .dmx-help-shot img {
    display: block;
    max-width: 100%;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
  }

  .dmx-help-lightbox {
    max-width: min(96vw, 1600px);
    max-height: 94vh;
    padding: 2.25rem 0.75rem 0.6rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: var(--sl-shadow-lg);
  }

  .dmx-help-lightbox::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  .dmx-help-lightbox img {
    display: block;
    max-width: 100%;
    max-height: calc(94vh - 5.5rem);
    margin: 0 auto;
    border-radius: 0.375rem;
    cursor: zoom-out;
  }

  .dmx-help-lightbox-close {
    position: absolute;
    top: 0.4rem;
    right: 0.5rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
  }

  .dmx-help-lightbox-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: var(--sl-text-xs);
  }

  .dmx-help-lightbox-caption {
    margin: 0;
    color: var(--sl-color-gray-3);
  }

  .dmx-help-shot figcaption {
    margin-top: 0.2rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .dmx-help-composer {
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .dmx-help-input {
    flex: 1;
    min-height: 2.6rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    resize: none;
  }

  .dmx-help-input:focus {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -1px;
  }

  .dmx-help-send {
    align-self: flex-end;
    padding: 0.45rem 0.9rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }

  .dmx-help-send.dmx-help-stop {
    background: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .dmx-help-continue {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.9rem 0.65rem;
    border-top: 1px solid var(--sl-color-hairline);
    text-decoration: none;
  }

  .dmx-help-continue span {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 50rem) {
    .dmx-help-panel {
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 0;
    }

    .dmx-help-open .dmx-help-launcher {
      display: none;
    }
  }
</style>
